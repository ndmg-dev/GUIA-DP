# ─────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────
# Conexão com o Postgres. Combina com o docker-compose.yml deste repo.
DATABASE_URL=postgresql://guia_dp:guia_dp@localhost:5432/guia_dp

# Provedor de LLM ativo. Valores suportados: "openai" | "anthropic" | "mock"
LLM_PROVIDER=openai

# Necessária se LLM_PROVIDER=openai
OPENAI_API_KEY=
# Modelo da OpenAI (opcional; padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Necessária apenas se LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Porta do backend
PORT=3333

# Origem permitida para CORS (o dev server do Vite)
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# Frontend (prefixo VITE_ é obrigatório para expor ao browser)
# ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3333
